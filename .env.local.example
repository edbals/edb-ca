# Copy to .env.local and fill in. Both keys are optional: the market panel
# works without either, using only keyless official sources.

# Adds the equity indices panel (SPY / QQQ / DIA).
# Free tier is plenty: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Adds the upcoming US data-release calendar under the market panel.
# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
